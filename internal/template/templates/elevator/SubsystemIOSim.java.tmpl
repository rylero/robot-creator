package {{.Package}}.subsystems.{{.NameLower}};

import static org.wpilib.units.Units.Amps;
import static org.wpilib.units.Units.Meters;
import static org.wpilib.units.Units.MetersPerSecond;
import static org.wpilib.units.Units.Volts;

import {{.Package}}.Constants;
import org.wpilib.math.system.DCMotor;
import org.wpilib.math.system.Models;
import org.wpilib.simulation.ElevatorSim;
import org.wpilib.units.measure.Distance;
import org.wpilib.units.measure.Voltage;

/** WPILib elevator plant with a simple PD position loop. Used in SIM only. */
public class {{.Name}}IOSim implements {{.Name}}IO {
  private static final double CARRIAGE_MASS_KG = 5.0; // TODO: from CAD
  private static final double KP_VOLTS_PER_METER = 60.0;
  private static final double KD_VOLTS_PER_METER_PER_SEC = 2.0;

  private final DCMotor gearbox = DCMotor.getKrakenX60({{.MotorCount}});
  private final ElevatorSim sim =
      new ElevatorSim(
          Models.elevatorFromPhysicalConstants(
              gearbox,
              CARRIAGE_MASS_KG,
              {{.Name}}Constants.DRUM_RADIUS_METERS,
              {{.Name}}Constants.GEARING),
          gearbox,
          {{.Name}}Constants.MIN_HEIGHT.in(Meters),
          {{.Name}}Constants.MAX_HEIGHT.in(Meters),
          true,
          {{.Name}}Constants.MIN_HEIGHT.in(Meters));

  private double appliedVolts;
  private Double targetMeters;

  @Override
  public void updateInputs({{.Name}}Inputs inputs) {
    if (targetMeters != null) {
      double error = targetMeters - sim.getPosition();
      appliedVolts =
          Math.clamp(
              KP_VOLTS_PER_METER * error - KD_VOLTS_PER_METER_PER_SEC * sim.getVelocity(),
              -12.0,
              12.0);
    }
    sim.setInputVoltage(appliedVolts);
    sim.update(Constants.ROBOT_PERIOD);

    double ampsPerMotor = Math.abs(sim.getCurrentDraw()) / {{.MotorCount}}.0;
    inputs.motorConnected = true;
{{- range .Followers}}
    inputs.follower{{.Index}}Connected = true;
{{- end}}
    inputs.position = Meters.of(sim.getPosition());
    inputs.velocity = MetersPerSecond.of(sim.getVelocity());
    inputs.appliedVoltage = Volts.of(appliedVolts);
    inputs.supplyCurrent = Amps.of(ampsPerMotor);
{{- range .Followers}}
    inputs.follower{{.Index}}SupplyCurrent = Amps.of(ampsPerMotor);
{{- end}}
  }

  @Override
  public void setPosition(Distance height) {
    targetMeters = height.in(Meters);
  }

  @Override
  public void setVoltage(Voltage voltage) {
    targetMeters = null;
    appliedVolts = Math.clamp(voltage.in(Volts), -12.0, 12.0);
  }
}
