package {{.Package}}.subsystems.{{.NameLower}};

{{- if not .Followers}}

import static {{.Package}}.util.PhoenixUtil.tryUntilOk;

import com.ctre.phoenix6.StatusSignal;
import com.ctre.phoenix6.StatusSignalCollection;
import com.ctre.phoenix6.controls.VoltageOut;
import com.ctre.phoenix6.hardware.TalonFX;
import org.wpilib.units.measure.AngularVelocity;
import org.wpilib.units.measure.Current;
import org.wpilib.units.measure.Voltage;

public class {{.Name}}IOTalonFX implements {{.Name}}IO {
  private final TalonFX motor;

  private final VoltageOut voltageRequest = new VoltageOut(0);

  private final StatusSignalCollection signals;
  private final StatusSignal<AngularVelocity> velocity;
  private final StatusSignal<Voltage> appliedVoltage;
  private final StatusSignal<Current> supplyCurrent;

  public {{.Name}}IOTalonFX() {
    motor = new TalonFX({{.Name}}Constants.MOTOR_ID, {{.Name}}Constants.CAN_BUS);

    var config = {{.Name}}Constants.config();
    tryUntilOk(5, () -> motor.getConfigurator().apply(config, 0.25));

    velocity = motor.getVelocity();
    appliedVoltage = motor.getMotorVoltage();
    supplyCurrent = motor.getSupplyCurrent();

    signals = new StatusSignalCollection(velocity, appliedVoltage, supplyCurrent);
  }

  @Override
  public void updateInputs({{.Name}}Inputs inputs) {
    signals.refreshAll();

    inputs.motorConnected = motor.isConnected();
    inputs.velocity = velocity.getValue();
    inputs.appliedVoltage = appliedVoltage.getValue();
    inputs.supplyCurrent = supplyCurrent.getValue();
  }

  @Override
  public void setVoltage(Voltage voltage) {
    motor.setControl(voltageRequest.withOutput(voltage));
  }
}
{{- else}}

import static {{.Package}}.util.PhoenixUtil.tryUntilOk;

import com.ctre.phoenix6.BaseStatusSignal;
import com.ctre.phoenix6.StatusSignal;
import com.ctre.phoenix6.controls.Follower;
import com.ctre.phoenix6.controls.VoltageOut;
import com.ctre.phoenix6.hardware.TalonFX;
import com.ctre.phoenix6.signals.InvertedValue;
import com.ctre.phoenix6.signals.MotorAlignmentValue;
import org.wpilib.math.filter.Debouncer;
import org.wpilib.units.measure.AngularVelocity;
import org.wpilib.units.measure.Current;
import org.wpilib.units.measure.Voltage;

/**
 * Leader plus followers with failover: if the leading motor drops off the bus, the first connected
 * motor takes over, the others follow it, and the last request is re-sent to it.
 */
public class {{.Name}}IOTalonFX implements {{.Name}}IO {
  private record Motor(
      TalonFX talon, StatusSignal<AngularVelocity> velocity, StatusSignal<Voltage> appliedVoltage, StatusSignal<Current> supplyCurrent, Debouncer connectedDebounce) {
    Motor(TalonFX talon) {
      this(
          talon, talon.getVelocity(), talon.getMotorVoltage(), talon.getSupplyCurrent(), new Debouncer({{.Name}}Constants.CONNECTION_DEBOUNCE_SECONDS, Debouncer.DebounceType.FALLING));
    }

    BaseStatusSignal[] signals() {
      return new BaseStatusSignal[] {velocity(), appliedVoltage(), supplyCurrent()};
    }
  }

  /** Index 0 is the configured leader, then follower 2, 3... */
  private final Motor[] motors;

  private final boolean[] connected;
  private final BaseStatusSignal[] signals;
  private int leader;

  private final VoltageOut voltageRequest = new VoltageOut(0);

  /** Re-sends the latest request; run again on whichever motor leads after a failover. */
  private Runnable lastRequest = () -> {};

  public {{.Name}}IOTalonFX() {
    motors =
        new Motor[] {
          new Motor(new TalonFX({{.Name}}Constants.MOTOR_ID, {{.Name}}Constants.CAN_BUS)),
{{- range .Followers}}
          new Motor(new TalonFX({{$.Name}}Constants.FOLLOWER_{{.Index}}_ID, {{$.Name}}Constants.CAN_BUS)),
{{- end}}
        };
    connected = new boolean[motors.length];
    signals = new BaseStatusSignal[motors.length * 3];

    for (int i = 0; i < motors.length; i++) {
      var talon = motors[i].talon();
      var config = {{.Name}}Constants.config();
      if (i > 0 && {{.Name}}Constants.FOLLOWER_ALIGNMENT == MotorAlignmentValue.Opposed) {
        // Opposed followers invert so every motor reads and takes setpoints in one frame,
        // which lets any of them lead.
        config.MotorOutput.Inverted =
            config.MotorOutput.Inverted == InvertedValue.Clockwise_Positive
                ? InvertedValue.CounterClockwise_Positive
                : InvertedValue.Clockwise_Positive;
      }
      tryUntilOk(5, () -> talon.getConfigurator().apply(config, 0.25));
      System.arraycopy(motors[i].signals(), 0, signals, i * 3, 3);
      connected[i] = true;
    }
    applyFollowers();
  }

  @Override
  public void updateInputs({{.Name}}Inputs inputs) {
    BaseStatusSignal.refreshAll(signals);

    for (int i = 0; i < motors.length; i++) {
      connected[i] = motors[i].connectedDebounce().calculate(motors[i].talon().isConnected());
    }
    int next = nextLeader(leader, connected);
    if (next != leader) {
      leader = next;
      applyFollowers();
      lastRequest.run();
    }

    inputs.motorConnected = connected[0];
{{- range .Followers}}
    inputs.follower{{.Index}}Connected = connected[{{.Index}} - 1];
{{- end}}
    inputs.leader = leader + 1;
    inputs.velocity = motors[leader].velocity().getValue();
    inputs.appliedVoltage = motors[leader].appliedVoltage().getValue();
    inputs.supplyCurrent = motors[0].supplyCurrent().getValue();
{{- range .Followers}}
    inputs.follower{{.Index}}SupplyCurrent = motors[{{.Index}} - 1].supplyCurrent().getValue();
{{- end}}
  }

  @Override
  public void setVoltage(Voltage voltage) {
    send(() -> leader().setControl(voltageRequest.withOutput(voltage)));
  }

  /** Sticky: keep the current leader while connected, else hand off to the first connected motor. */
  static int nextLeader(int current, boolean[] connected) {
    if (connected[current]) {
      return current;
    }
    for (int i = 0; i < connected.length; i++) {
      if (connected[i]) {
        return i;
      }
    }
    return current;
  }

  private TalonFX leader() {
    return motors[leader].talon();
  }

  private void send(Runnable request) {
    lastRequest = request;
    request.run();
  }

  private void applyFollowers() {
    for (int i = 0; i < motors.length; i++) {
      if (i != leader) {
        motors[i].talon().setControl(new Follower(leader().getDeviceID(), alignment(i, leader)));
      }
    }
  }

  /** The configured leader is FOLLOWER_ALIGNMENT to every follower; followers align to each other. */
  private static MotorAlignmentValue alignment(int a, int b) {
    return (a == 0) == (b == 0) ? MotorAlignmentValue.Aligned : {{.Name}}Constants.FOLLOWER_ALIGNMENT;
  }
}
{{- end}}
