package {{.Package}}.subsystems.{{.NameLower}};

import static org.wpilib.units.Units.Rotations;
import static org.wpilib.units.Units.Volts;

import {{.Package}}.util.Measures;
import java.util.function.Supplier;
import org.littletonrobotics.junction.Logger;
import org.wpilib.command3.Command;
import org.wpilib.command3.Mechanism;
import org.wpilib.units.measure.Angle;
import org.wpilib.util.Alert;
import org.wpilib.util.Alert.Level;

public class {{.Name}} implements Mechanism, AutoCloseable {
  private final {{.Name}}IO io;
  private final {{.Name}}InputsAutoLogged inputs = new {{.Name}}InputsAutoLogged();

  /** Non-null only while in closed-loop position control. */
  private Angle setpoint;

  private final Alert motorDisconnectedAlert =
      new Alert("{{.Name}}", "motorDisconnected", "{{.Name}} motor disconnected.", Level.HIGH);
{{- range .Followers}}
  private final Alert follower{{.Index}}DisconnectedAlert =
      new Alert(
          "{{$.Name}}",
          "follower{{.Index}}Disconnected",
          "{{$.Name}} follower {{.Index}} disconnected.",
          Level.HIGH);
{{- end}}

  public {{.Name}}({{.Name}}IO io) {
    this.io = io;
    setDefaultCommand(idle());
  }

  /** Called from Robot.robotPeriodic() before the scheduler runs. */
  public void periodic() {
    io.updateInputs(inputs);
    Logger.processInputs("{{.Name}}", inputs);

    motorDisconnectedAlert.set(!inputs.motorConnected);
{{- range .Followers}}
    follower{{.Index}}DisconnectedAlert.set(!inputs.follower{{.Index}}Connected);
{{- end}}

    Logger.recordOutput("{{.Name}}/Setpoint", setpoint != null ? setpoint : Rotations.of(0.0));
    Logger.recordOutput("{{.Name}}/ClosedLoop", setpoint != null);
    Logger.recordOutput("{{.Name}}/AtSetpoint", atSetpoint());
  }

  @Override
  public Command idle() {
    return runRepeatedly(
            () -> {
              setpoint = null;
              io.setVoltage(Volts.of(0.0));
            })
        .named("{{.Name}}[IDLE]");
  }

  /** Holds the mechanism at {@code angle} until interrupted. */
  public Command hold(Angle angle) {
    return hold(() -> angle);
  }

  public Command hold(Supplier<Angle> angle) {
    return runRepeatedly(() -> commandPosition(angle.get())).named("{{.Name}}Hold");
  }

  /**
   * Drives to {@code angle} and finishes once within tolerance. The default command takes over
   * afterwards, so use {@link #hold} when the mechanism must stay there.
   */
  public Command moveTo(Angle angle) {
    return run(coroutine -> {
          do {
            commandPosition(angle);
            coroutine.yield();
          } while (!atSetpoint());
        })
        .named("{{.Name}}MoveTo");
  }

  public boolean atSetpoint() {
    return setpoint != null && inputs.position.isNear(setpoint, {{.Name}}Constants.TOLERANCE);
  }

  public Angle getPosition() {
    return inputs.position;
  }

  @Override
  public void close() {
    motorDisconnectedAlert.close();
{{- range .Followers}}
    follower{{.Index}}DisconnectedAlert.close();
{{- end}}
  }

  private void commandPosition(Angle desired) {
    setpoint = clamp(desired);
    if (setpoint != null) {
      io.setPosition(setpoint);
    } else {
      io.setVoltage(Volts.of(0.0));
    }
  }

  private static Angle clamp(Angle angle) {
    if (!Measures.isFinite(angle)) {
      return null;
    }
    double min = {{.Name}}Constants.MIN_POSITION.in(Rotations);
    double max = {{.Name}}Constants.MAX_POSITION.in(Rotations);
    return Rotations.of(Math.min(max, Math.max(min, angle.in(Rotations))));
  }
}
