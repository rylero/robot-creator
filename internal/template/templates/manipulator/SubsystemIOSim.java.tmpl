package {{.Package}}.subsystems.{{.NameLower}};

import static org.wpilib.units.Units.Amps;
import static org.wpilib.units.Units.Radians;
import static org.wpilib.units.Units.RadiansPerSecond;
import static org.wpilib.units.Units.Volts;

import {{.Package}}.Constants;
import {{.Package}}.sim.VelocityPlant;
import org.wpilib.math.system.DCMotor;
import org.wpilib.units.measure.Angle;
import org.wpilib.units.measure.Voltage;

/**
 * WPILib flywheel plant integrated to a position, with a simple PD position loop. Fine for wrists,
 * claws, or any position mechanism whose inertia is unknown. Used in SIM only.
 */
public class {{.Name}}IOSim implements {{.Name}}IO {
  private static final double MOI_KG_M2 = 0.01; // TODO: from CAD
  private static final double KP_VOLTS_PER_RAD = 2.0;
  private static final double KD_VOLTS_PER_RAD_PER_SEC = 0.1;

  private final VelocityPlant plant =
      new VelocityPlant(DCMotor.getKrakenX60({{.MotorCount}}), MOI_KG_M2, {{.Name}}Constants.GEARING);

  private double positionRad = {{.Name}}Constants.MIN_POSITION.in(Radians);
  private Double targetRad;

  @Override
  public void updateInputs({{.Name}}Inputs inputs) {
    if (targetRad != null) {
      double error = targetRad - positionRad;
      plant.setVoltage(
          KP_VOLTS_PER_RAD * error - KD_VOLTS_PER_RAD_PER_SEC * plant.velocityRadPerSec());
    }
    plant.update();
    positionRad += plant.velocityRadPerSec() * Constants.ROBOT_PERIOD;

    double ampsPerMotor = plant.currentAmps() / {{.MotorCount}}.0;
    inputs.motorConnected = true;
{{- range .Followers}}
    inputs.follower{{.Index}}Connected = true;
{{- end}}
    inputs.position = Radians.of(positionRad);
    inputs.velocity = RadiansPerSecond.of(plant.velocityRadPerSec());
    inputs.appliedVoltage = Volts.of(plant.appliedVolts());
    inputs.supplyCurrent = Amps.of(ampsPerMotor);
{{- range .Followers}}
    inputs.follower{{.Index}}SupplyCurrent = Amps.of(ampsPerMotor);
{{- end}}
  }

  @Override
  public void setPosition(Angle angle) {
    targetRad = angle.in(Radians);
  }

  @Override
  public void setVoltage(Voltage voltage) {
    targetRad = null;
    plant.setVoltage(voltage.in(Volts));
  }
}
