package {{.Package}}.subsystems.{{.NameLower}};

import static org.wpilib.units.Units.Amps;
import static org.wpilib.units.Units.Radians;
import static org.wpilib.units.Units.RadiansPerSecond;
import static org.wpilib.units.Units.Volts;

import {{.Package}}.Constants;
import org.wpilib.math.system.DCMotor;
import org.wpilib.math.system.Models;
import org.wpilib.simulation.SingleJointedArmSim;
import org.wpilib.units.measure.Angle;
import org.wpilib.units.measure.Voltage;

/** WPILib single-jointed arm plant with a simple PD position loop. Used in SIM only. */
public class {{.Name}}IOSim implements {{.Name}}IO {
  private static final double MOI_KG_M2 = 0.04; // TODO: from CAD
  private static final double ARM_LENGTH_M = 0.3; // TODO: from CAD
  private static final double KP_VOLTS_PER_RAD = 8.0;
  private static final double KD_VOLTS_PER_RAD_PER_SEC = 0.3;

  private final DCMotor gearbox = DCMotor.getKrakenX60({{.MotorCount}});
  private final SingleJointedArmSim sim =
      new SingleJointedArmSim(
          Models.singleJointedArmFromPhysicalConstants(
              gearbox, MOI_KG_M2, {{.Name}}Constants.GEARING),
          gearbox,
          {{.Name}}Constants.GEARING,
          ARM_LENGTH_M,
          {{.Name}}Constants.MIN_ANGLE.in(Radians),
          {{.Name}}Constants.MAX_ANGLE.in(Radians),
          true,
          {{.Name}}Constants.MIN_ANGLE.in(Radians));

  private double appliedVolts;
  private Double targetRad;

  @Override
  public void updateInputs({{.Name}}Inputs inputs) {
    if (targetRad != null) {
      double error = targetRad - sim.getAngle();
      appliedVolts =
          Math.clamp(
              KP_VOLTS_PER_RAD * error - KD_VOLTS_PER_RAD_PER_SEC * sim.getVelocity(), -12.0, 12.0);
    }
    sim.setInputVoltage(appliedVolts);
    sim.update(Constants.ROBOT_PERIOD);

    double ampsPerMotor = Math.abs(sim.getCurrentDraw()) / {{.MotorCount}}.0;
    inputs.motorConnected = true;
{{- range .Followers}}
    inputs.follower{{.Index}}Connected = true;
{{- end}}
    inputs.position = Radians.of(sim.getAngle());
    inputs.velocity = RadiansPerSecond.of(sim.getVelocity());
    inputs.appliedVoltage = Volts.of(appliedVolts);
    inputs.supplyCurrent = Amps.of(ampsPerMotor);
{{- range .Followers}}
    inputs.follower{{.Index}}SupplyCurrent = Amps.of(ampsPerMotor);
{{- end}}
  }

  @Override
  public void setPosition(Angle angle) {
    targetRad = angle.in(Radians);
  }

  @Override
  public void setVoltage(Voltage voltage) {
    targetRad = null;
    appliedVolts = Math.clamp(voltage.in(Volts), -12.0, 12.0);
  }
}
