package {{.Package}}.subsystems.{{.NameLower}};

import com.ctre.phoenix6.CANBus;
import com.ctre.phoenix6.configs.TalonFXConfiguration;
import com.ctre.phoenix6.signals.InvertedValue;
{{- if .Followers}}
import com.ctre.phoenix6.signals.MotorAlignmentValue;
{{- end}}
import com.ctre.phoenix6.signals.NeutralModeValue;
import {{.Package}}.util.PhoenixUtil;
import org.wpilib.hardware.bus.CANPort;

public final class {{.Name}}Constants {
  private {{.Name}}Constants() {}

  public static final int MOTOR_ID = {{.LeaderID}}; // TODO: set CAN ID
{{- range .Followers}}
  public static final int FOLLOWER_{{.Index}}_ID = {{.DefaultID}}; // TODO: set CAN ID
{{- end}}
  public static final CANBus CAN_BUS = new CANBus(CANPort.CAN_S0);

  public static final InvertedValue INVERTED = InvertedValue.CounterClockwise_Positive;
{{- if .Followers}}
  public static final MotorAlignmentValue FOLLOWER_ALIGNMENT = MotorAlignmentValue.{{if .Aligned}}Aligned{{else}}Opposed{{end}};
{{- end}}

  /** Motor rotations per mechanism rotation. */
  public static final double GEARING = 1.0;

  public static final double MAX_VOLTS = 12.0;
  public static final double STATOR_CURRENT_LIMIT = 60.0;
  public static final double SUPPLY_CURRENT_LIMIT = 40.0;

  public static TalonFXConfiguration config() {
    var config = new TalonFXConfiguration();
    config.Feedback.SensorToMechanismRatio = GEARING;
    config.MotorOutput.NeutralMode = NeutralModeValue.Brake;
    config.MotorOutput.Inverted = INVERTED;
    PhoenixUtil.applySafetyLimits(config, MAX_VOLTS, STATOR_CURRENT_LIMIT, SUPPLY_CURRENT_LIMIT);
    return config;
  }
}
